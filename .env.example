# API runtime
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# MongoDB (required starting in Phase 3/4)
MONGODB_URI=<populated in real .env>

# Firebase (required starting in Phase 3)
FIREBASE_PROJECT_ID=<populated in real .env>
FIREBASE_CLIENT_EMAIL=<populated in real .env>
FIREBASE_PRIVATE_KEY=<populated in real .env>
VITE_FIREBASE_API_KEY=<populated in real .env>
VITE_FIREBASE_AUTH_DOMAIN=<populated in real .env>
VITE_FIREBASE_PROJECT_ID=<populated in real .env>
VITE_FIREBASE_STORAGE_BUCKET=<populated in real .env>
VITE_FIREBASE_MESSAGING_SENDER_ID=<populated in real .env>
VITE_FIREBASE_APP_ID=<populated in real .env>
VITE_FIREBASE_MEASUREMENT_ID=<populated in real .env>

# Private asset storage (required starting in Phase 5)
AWS_REGION=<populated in real .env>
AWS_S3_BUCKET=<populated in real .env>
AWS_ACCESS_KEY_ID=<populated in real .env>
AWS_SECRET_ACCESS_KEY=<populated in real .env>
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY=

# Owner-recoverable share links (required starting with the share-link library)
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHARE_TOKEN_ENCRYPTION_KEY=<populated in real .env>

# Optional local-network testing. Set this to this computer's IPv4 address, for example
# LOCAL_DEV_IP=192.168.1.42. With it set, `pnpm dev` exposes Vite on your LAN at port 5173.
LOCAL_DEV_IP=
